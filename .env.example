# Peblo TV Mini Environment Variables
# Backend config is read with the PEBLO_ prefix (see backend/config.py).
# Copy this to your environment / docker-compose and adjust as needed.

# Database DSN (PostgreSQL) — defaults to SQLite when unset
PEBLO_POSTGRES_DSN=postgresql://postgres:postgres@db:5432/peblo_tv_mini

# Application
PEBLO_SECRET_KEY=change-me-dev
PEBLO_ADMIN_PASSWORD=admin123

# Storage
PEBLO_STORAGE_BACKEND=local  # or "r2"
PEBLO_STORAGE_LOCAL_DIR=/storage

# Startup seeding (true = seed demo content on an empty DB)
PEBLO_SEED_ON_STARTUP=true

# Cloudflare R2 (only needed if PEBLO_STORAGE_BACKEND=r2)
# PEBLO_R2_ACCOUNT_ID=your_account_id
# PEBLO_R2_ACCESS_KEY=your_access_key
# PEBLO_R2_SECRET_KEY=your_secret_key
# PEBLO_R2_BUCKET=peblo-tv
# PEBLO_R2_ENDPOINT=https://api.cloudflare.com/client/v4/